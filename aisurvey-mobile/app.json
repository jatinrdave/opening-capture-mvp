{
  "expo": {
    "name": "aisurvey-mobile",
    "slug": "aisurvey-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aisurveymobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "AISurvey uses the camera for capture-first opening photos.",
          "microphonePermission": "AISurvey uses the microphone only when recording optional installation video.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AISurvey uses your location to stamp capture sessions with GPS coordinates when permitted.",
          "locationAlwaysAndWhenInUsePermission": "AISurvey uses your location to stamp capture sessions with GPS coordinates when permitted."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
